#version 460 core
layout (local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

#define MAX_SOURCES 32

layout(binding = 0) uniform writeonly image2D target;
layout(binding = 1) uniform sampler2D sources[MAX_SOURCES];

layout(location = 0) uniform int source_count;


void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(target);

    if (pixel.x >= size.x || pixel.y >= size.y) {
        return;
    }

    vec2 uv = (vec2(pixel) + 0.5) / vec2(size);

    vec4 accum = vec4(0.0); // Premultiplied: accum.rgb already multiplied by accum.a

    for (int i = 0; i < source_count && i < MAX_SOURCES; ++i) {
        vec4 layerColor = texture(sources[i], uv);

        // Premultiply this layer's color by its own alpha
        vec3 layerPremult = layerColor.rgb * layerColor.a;

        // "Over" operator in premultiplied space:
        // out = src + dst * (1 - src.a)
        accum.rgb = layerPremult + accum.rgb * (1.0 - layerColor.a);
        accum.a   = layerColor.a + accum.a   * (1.0 - layerColor.a);
    }

    imageStore(target, pixel, accum);
}
